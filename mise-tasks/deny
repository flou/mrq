#!/usr/bin/env bash
#MISE description="Check dependency licenses, advisories, bans and sources with cargo-deny."
# deny.toml is the source of truth for what is allowed. The allow list is deliberately
# explicit, so a new dependency with a copyleft or unrecognised license fails here rather
# than silently shipping.
# Pinned to an exact version so the rules are reproducible on every machine and in CI.

set -Eeuo pipefail

cd "${MISE_PROJECT_ROOT:-$(dirname "$0")/..}"

printf '\n\033[1m== cargo-deny ==\033[0m\n'
exec mise x aqua:EmbarkStudios/cargo-deny@0.20.2 -- cargo deny check
