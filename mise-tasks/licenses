#!/usr/bin/env bash
#MISE description="Regenerate THIRD-PARTY-LICENSES.md from the locked dependency graph."
# The release workflow runs this and bundles the result alongside the binary, which is what
# satisfies the attribution terms of the Apache-2.0 (and similar) crates mrq depends on.
# Pinned to an exact version so the output is reproducible.

set -Eeuo pipefail

cd "${MISE_PROJECT_ROOT:-$(dirname "$0")/..}"

printf '\n\033[1m== third-party licenses ==\033[0m\n'
exec mise x github:EmbarkStudios/cargo-about@0.9.2 -- \
  cargo about generate about.md.hbs --locked -o THIRD-PARTY-LICENSES.md
